generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model Organization {
  id               String                  @id @default(cuid())
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  name             String
  slug             String                  @unique
  logoUrl          String?
  website          String?
  industry         String?
  plan             PlanTier                @default(FREE)
  maxUsers         Int                     @default(5)
  maxDocuments     Int                     @default(20)
  maxLeads         Int                     @default(500)
  activities       Activity[]
  aiInteractions   AiInteraction[]
  apiKeys          ApiKey[]
  deals            Deal[]
  documents        Document[]
  documentVersions DocumentVersion[]
  drafts           Draft[]
  draftRevisions   DraftRevision[]
  draftSources     DraftRevisionSource[]
  draftApprovals   DraftApproval[]
  draftExportRequests DraftExportRequest[]
  approvedAnswers  ApprovedAnswer[]
  approvedAnswerRevisions ApprovedAnswerRevision[]
  approvedAnswerSources ApprovedAnswerRevisionSource[]
  approvedAnswerApprovals ApprovedAnswerApproval[]
  approvedAnswerInvalidations ApprovedAnswerInvalidation[]
  externalMappings ExternalObjectMapping[]
  integrations     Integration[]
  invites          Invite[]
  leads            Lead[]
  syncLogs         SyncLog[]
  tasks            Task[]
  users            User[]
  webhookEvents    WebhookEvent[]
  workflowRuns     WorkflowRun[]
  workflowRunActivities WorkflowRunActivity[]
  questionnaireJobs QuestionnaireJob[]
  workflows        WorkflowTrigger[]
  workloadReservations WorkloadReservation[]
  usageTraces      UsageTrace[]
  usageControl     OrganizationUsageControl?
  usageAlerts      UsageAlertEvent[]

  @@map("organizations")
}

model User {
  id                String          @id @default(cuid())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  email             String          @unique
  passwordHash      String
  firstName         String
  lastName          String
  avatarUrl         String?
  phone             String?
  title             String?
  timezone          String          @default("UTC")
  role              UserRole        @default(REP)
  isActive          Boolean         @default(true)
  lastLoginAt       DateTime?
  emailVerified     Boolean         @default(false)
  organizationId    String
  activities        Activity[]
  aiInteractions    AiInteraction[]
  assignedDeals     Deal[]          @relation("DealOwner")
  uploadedDocuments Document[]
  authoredDrafts     Draft[]         @relation("DraftAuthor")
  authoredDraftRevisions DraftRevision[] @relation("DraftRevisionAuthor")
  reviewedDraftApprovals DraftApproval[] @relation("DraftApprovalReviewer")
  requestedDraftExports DraftExportRequest[] @relation("DraftExportRequester")
  ownedApprovedAnswers ApprovedAnswer[] @relation("ApprovedAnswerOwner")
  authoredApprovedAnswerRevisions ApprovedAnswerRevision[] @relation("ApprovedAnswerRevisionAuthor")
  reviewedApprovedAnswerApprovals ApprovedAnswerApproval[] @relation("ApprovedAnswerApprovalReviewer")
  assignedLeads     Lead[]          @relation("AssignedRep")
  createdLeads      Lead[]          @relation("LeadCreator")
  passwordRecoveries PasswordRecovery[]
  refreshTokens     RefreshToken[]
  assignedTasks     Task[]          @relation("TaskAssignee")
  createdTasks      Task[]          @relation("TaskCreator")
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@unique([id, organizationId])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  token     String   @unique
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model Invite {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  expiresAt      DateTime
  email          String
  role           UserRole     @default(REP)
  token          String       @unique
  status         InviteStatus @default(PENDING)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([token])
  @@map("invites")
}

model Document {
  id             String          @id @default(cuid())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  filename       String
  displayName    String
  description    String?
  mimeType       String
  sizeBytes      Int
  fileType       DocumentType
  storagePath    String
  status         DocumentStatus  @default(PENDING)
  errorMessage   String?
  pageCount      Int?
  totalChunks    Int?
  embeddingModel String?
  ingestedAt     DateTime?
  jobId          String?
  activeVersionId String?
  nextVersionNumber Int @default(1)
  deletedAt      DateTime?
  tags           String[]
  organizationId String
  uploadedById   String
  aiInteractions AiInteraction[]
  chunks         DocumentChunk[]
  versions       DocumentVersion[]
  draftSources   DraftRevisionSource[]
  approvedAnswerSources ApprovedAnswerRevisionSource[]
  approvedAnswerInvalidations ApprovedAnswerInvalidation[]
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy     User            @relation(fields: [uploadedById], references: [id])

  @@index([organizationId])
  @@index([status])
  @@index([uploadedById])
  @@unique([id, organizationId])
  @@map("documents")
}

model DocumentVersion {
  id             String @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  documentId     String
  organizationId String
  versionNumber  Int
  basedOnVersionId String?
  contentHash    String?
  filename       String
  mimeType       String
  sizeBytes      Int
  fileType       DocumentType
  storagePath    String
  status         DocumentVersionStatus @default(BUILDING)
  errorMessage   String?
  pageCount      Int?
  totalChunks    Int?
  embeddingModel String?
  publishedAt    DateTime?
  chunks         DocumentChunk[]
  draftSources   DraftRevisionSource[]
  approvedAnswerSources ApprovedAnswerRevisionSource[]
  previousApprovedAnswerInvalidations ApprovedAnswerInvalidation[] @relation("ApprovedAnswerInvalidationPreviousVersion")
  currentApprovedAnswerInvalidations ApprovedAnswerInvalidation[] @relation("ApprovedAnswerInvalidationCurrentVersion")
  document       Document @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNumber])
  @@unique([id, documentId])
  @@unique([id, documentId, organizationId])
  @@index([organizationId, documentId])
  @@map("document_versions")
}

model DocumentChunk {
  id            String                 @id @default(cuid())
  createdAt     DateTime               @default(now())
  chunkIndex    Int
  text          String
  tokenCount    Int
  pageNumber    Int?
  documentId    String
  versionId     String
  headingPath   String[]
  overlapTokens Int                    @default(0)
  sectionTitle  String?
  embedding     Unsupported("vector(768)")?
  legacyEmbedding Unsupported("vector(384)")?
  document      Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version       DocumentVersion        @relation(fields: [versionId, documentId], references: [id, documentId], onDelete: Cascade)
  draftSources  DraftRevisionSource[]
  approvedAnswerSources ApprovedAnswerRevisionSource[]

  @@unique([versionId, chunkIndex])
  @@unique([id, versionId, documentId])
  @@index([documentId])
  @@map("document_chunks")
}

model Draft {
  id                   String                @id @default(cuid())
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  title                String?
  question             String
  requestedDocumentIds String[]
  idempotencyKey       String
  requestFingerprint   String
  processingStatus     DraftProcessingStatus @default(PROCESSING)
  reviewStatus         DraftReviewStatus     @default(REQUIRED)
  deliveryStatus       DraftDeliveryStatus   @default(NOT_REQUESTED)
  generationErrorCode  String?
  currentRevisionId    String?
  concurrencyToken     Int                   @default(0)
  archivedAt           DateTime?
  organizationId       String
  authorId             String?
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author               User?                 @relation("DraftAuthor", fields: [authorId, organizationId], references: [id, organizationId])
  revisions            DraftRevision[]       @relation("DraftRevisions")
  currentRevision      DraftRevision?        @relation("CurrentDraftRevision", fields: [currentRevisionId, id, organizationId], references: [id, draftId, organizationId], onDelete: NoAction, onUpdate: NoAction)
  approvals            DraftApproval[]
  exportRequests       DraftExportRequest[]
  questionnaireRow     QuestionnaireRow?
  reusedApprovedAnswerId String?
  reusedApprovedAnswerRevisionId String?
  reusedApprovedAnswer ApprovedAnswer? @relation("ReusedApprovedAnswer", fields: [reusedApprovedAnswerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  reusedApprovedAnswerRevision ApprovedAnswerRevision? @relation("ReusedApprovedAnswerRevision", fields: [reusedApprovedAnswerRevisionId, reusedApprovedAnswerId, organizationId], references: [id, approvedAnswerId, organizationId], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@unique([id, organizationId])
  @@unique([currentRevisionId, id, organizationId])
  @@index([organizationId, archivedAt, updatedAt])
  @@index([organizationId, processingStatus, updatedAt])
  @@map("drafts")
}

model DraftRevision {
  id              String                @id @default(cuid())
  createdAt       DateTime              @default(now())
  revisionNumber  Int
  content         String
  origin          DraftRevisionOrigin
  isRefusal       Boolean               @default(false)
  aiInteractionId String?
  organizationId  String
  draftId         String
  authorId        String?
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  draft           Draft                 @relation("DraftRevisions", fields: [draftId, organizationId], references: [id, organizationId], onDelete: Cascade)
  currentForDraft Draft?                @relation("CurrentDraftRevision")
  author          User?                 @relation("DraftRevisionAuthor", fields: [authorId, organizationId], references: [id, organizationId])
  sources         DraftRevisionSource[]
  approvals       DraftApproval[]
  exportRequests  DraftExportRequest[]
  approvedAnswerLineage ApprovedAnswerRevision[] @relation("ApprovedAnswerDraftRevisionLineage")

  @@unique([draftId, revisionNumber])
  @@unique([id, draftId, organizationId])
  @@unique([id, organizationId])
  @@index([organizationId, draftId, createdAt])
  @@map("draft_revisions")
}

model DraftRevisionSource {
  id              String          @id @default(cuid())
  createdAt       DateTime        @default(now())
  ordinal         Int
  organizationId  String
  draftRevisionId String
  documentId      String
  versionId       String
  chunkId         String
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  revision        DraftRevision   @relation(fields: [draftRevisionId, organizationId], references: [id, organizationId], onDelete: Cascade)
  document        Document        @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  version         DocumentVersion @relation(fields: [versionId, documentId, organizationId], references: [id, documentId, organizationId], onDelete: Restrict)
  chunk           DocumentChunk   @relation(fields: [chunkId, versionId, documentId], references: [id, versionId, documentId], onDelete: Restrict)

  @@unique([draftRevisionId, ordinal])
  @@unique([draftRevisionId, chunkId])
  @@index([organizationId, documentId, versionId])
  @@map("draft_revision_sources")
}

model DraftApproval {
  id             String                @id @default(cuid())
  createdAt      DateTime              @default(now())
  decision       DraftApprovalDecision
  note           String?
  organizationId String
  draftId        String
  revisionId     String
  reviewerId     String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  draft          Draft                 @relation(fields: [draftId, organizationId], references: [id, organizationId], onDelete: Cascade)
  revision       DraftRevision         @relation(fields: [revisionId, draftId, organizationId], references: [id, draftId, organizationId], onDelete: Restrict)
  reviewer       User                  @relation("DraftApprovalReviewer", fields: [reviewerId, organizationId], references: [id, organizationId])
  approvedAnswerLineage ApprovedAnswerApproval[] @relation("ApprovedAnswerDraftApprovalLineage")

  @@unique([id, organizationId])
  @@index([organizationId, draftId, createdAt])
  @@index([revisionId, createdAt])
  @@map("draft_approvals")
}

model DraftExportRequest {
  id             String                   @id @default(cuid())
  createdAt      DateTime                 @default(now())
  includeSources Boolean                  @default(false)
  organizationId String
  draftId        String
  revisionId     String
  requesterId    String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  draft          Draft                    @relation(fields: [draftId, organizationId], references: [id, organizationId], onDelete: Cascade)
  revision       DraftRevision            @relation(fields: [revisionId, draftId, organizationId], references: [id, draftId, organizationId], onDelete: Restrict)
  requester      User                     @relation("DraftExportRequester", fields: [requesterId, organizationId], references: [id, organizationId])
  confirmations  DraftCopyConfirmation[]

  @@index([organizationId, draftId, createdAt])
  @@map("draft_export_requests")
}

model DraftCopyConfirmation {
  id        String            @id @default(cuid())
  createdAt DateTime          @default(now())
  exportId  String
  export    DraftExportRequest @relation(fields: [exportId], references: [id], onDelete: Cascade)

  @@index([exportId, createdAt])
  @@map("draft_copy_confirmations")
}

model ApprovedAnswer {
  id                String            @id @default(cuid())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  title             String
  question          String
  tags              String[]
  reviewStatus      DraftReviewStatus @default(APPROVED)
  currentRevisionId String?
  concurrencyToken  Int               @default(1)
  archivedAt        DateTime?
  organizationId    String
  ownerId           String
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner             User              @relation("ApprovedAnswerOwner", fields: [ownerId, organizationId], references: [id, organizationId])
  revisions         ApprovedAnswerRevision[] @relation("ApprovedAnswerRevisions")
  currentRevision   ApprovedAnswerRevision? @relation("CurrentApprovedAnswerRevision", fields: [currentRevisionId, id, organizationId], references: [id, approvedAnswerId, organizationId], onDelete: NoAction, onUpdate: NoAction)
  approvals         ApprovedAnswerApproval[]
  invalidations     ApprovedAnswerInvalidation[]
  reusedDrafts      Draft[] @relation("ReusedApprovedAnswer")

  @@unique([id, organizationId])
  @@unique([currentRevisionId, id, organizationId])
  @@index([organizationId, archivedAt, updatedAt])
  @@index([organizationId, reviewStatus, updatedAt])
  @@map("approved_answers")
}

model ApprovedAnswerRevision {
  id                    String   @id @default(cuid())
  createdAt             DateTime @default(now())
  revisionNumber        Int
  title                 String
  question              String
  content               String
  tags                  String[]
  organizationId        String
  approvedAnswerId      String
  authorId              String
  sourceDraftRevisionId String?
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  approvedAnswer        ApprovedAnswer @relation("ApprovedAnswerRevisions", fields: [approvedAnswerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  currentForAnswer      ApprovedAnswer? @relation("CurrentApprovedAnswerRevision")
  author                User @relation("ApprovedAnswerRevisionAuthor", fields: [authorId, organizationId], references: [id, organizationId])
  sourceDraftRevision   DraftRevision? @relation("ApprovedAnswerDraftRevisionLineage", fields: [sourceDraftRevisionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  sources               ApprovedAnswerRevisionSource[]
  approvals             ApprovedAnswerApproval[]
  reusedDrafts          Draft[] @relation("ReusedApprovedAnswerRevision")
  invalidations         ApprovedAnswerInvalidation[] @relation("ApprovedAnswerInvalidatedRevision")
  replacementInvalidations ApprovedAnswerInvalidation[] @relation("ApprovedAnswerReplacementRevision")

  @@unique([approvedAnswerId, revisionNumber])
  @@unique([id, approvedAnswerId, organizationId])
  @@unique([id, organizationId])
  @@unique([organizationId, sourceDraftRevisionId])
  @@index([organizationId, approvedAnswerId, createdAt])
  @@map("approved_answer_revisions")
}

model ApprovedAnswerRevisionSource {
  id                       String @id @default(cuid())
  createdAt                DateTime @default(now())
  ordinal                  Int
  organizationId           String
  approvedAnswerRevisionId String
  documentId               String
  versionId                String
  chunkId                  String
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  revision                 ApprovedAnswerRevision @relation(fields: [approvedAnswerRevisionId, organizationId], references: [id, organizationId], onDelete: Cascade)
  document                 Document @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  version                  DocumentVersion @relation(fields: [versionId, documentId, organizationId], references: [id, documentId, organizationId], onDelete: Restrict)
  chunk                    DocumentChunk @relation(fields: [chunkId, versionId, documentId], references: [id, versionId, documentId], onDelete: Restrict)

  @@unique([approvedAnswerRevisionId, ordinal])
  @@unique([approvedAnswerRevisionId, chunkId])
  @@index([organizationId, documentId, versionId])
  @@map("approved_answer_revision_sources")
}

model ApprovedAnswerApproval {
  id                    String @id @default(cuid())
  createdAt             DateTime @default(now())
  reviewedAt            DateTime
  decision              DraftApprovalDecision
  note                  String?
  organizationId        String
  approvedAnswerId      String
  revisionId            String
  reviewerId            String
  sourceDraftApprovalId String?
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  approvedAnswer        ApprovedAnswer @relation(fields: [approvedAnswerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  revision              ApprovedAnswerRevision @relation(fields: [revisionId, approvedAnswerId, organizationId], references: [id, approvedAnswerId, organizationId], onDelete: Restrict)
  reviewer              User @relation("ApprovedAnswerApprovalReviewer", fields: [reviewerId, organizationId], references: [id, organizationId])
  sourceDraftApproval   DraftApproval? @relation("ApprovedAnswerDraftApprovalLineage", fields: [sourceDraftApprovalId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, approvedAnswerId, createdAt])
  @@index([revisionId, createdAt])
  @@map("approved_answer_approvals")
}

model ApprovedAnswerInvalidation {
  id                    String @id @default(cuid())
  createdAt             DateTime @default(now())
  reason                ApprovedAnswerInvalidationReason
  organizationId        String
  approvedAnswerId      String
  invalidatedRevisionId String
  replacementRevisionId String?
  documentId            String?
  previousVersionId     String?
  currentVersionId      String?
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  approvedAnswer        ApprovedAnswer @relation(fields: [approvedAnswerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  invalidatedRevision   ApprovedAnswerRevision @relation("ApprovedAnswerInvalidatedRevision", fields: [invalidatedRevisionId, approvedAnswerId, organizationId], references: [id, approvedAnswerId, organizationId], onDelete: Restrict)
  replacementRevision   ApprovedAnswerRevision? @relation("ApprovedAnswerReplacementRevision", fields: [replacementRevisionId, approvedAnswerId, organizationId], references: [id, approvedAnswerId, organizationId], onDelete: Restrict)
  document              Document? @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  previousVersion       DocumentVersion? @relation("ApprovedAnswerInvalidationPreviousVersion", fields: [previousVersionId, documentId, organizationId], references: [id, documentId, organizationId], onDelete: Restrict)
  currentVersion        DocumentVersion? @relation("ApprovedAnswerInvalidationCurrentVersion", fields: [currentVersionId, documentId, organizationId], references: [id, documentId, organizationId], onDelete: Restrict)

  @@index([organizationId, approvedAnswerId, createdAt])
  @@index([organizationId, documentId, createdAt])
  @@map("approved_answer_invalidations")
}

model Lead {
  id              String          @id @default(cuid())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  firstName       String
  lastName        String
  email           String?
  phone           String?
  linkedinUrl     String?
  avatarUrl       String?
  company         String?
  jobTitle        String?
  department      String?
  companySize     String?
  industry        String?
  website         String?
  country         String?
  city            String?
  status          LeadStatus      @default(NEW)
  source          LeadSource      @default(MANUAL)
  tags            String[]
  notes           String?
  aiScore         Int?
  aiScoreReason   String?
  aiSummary       String?
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  emailOpenCount  Int             @default(0)
  emailClickCount Int             @default(0)
  customFields    Json?
  organizationId  String
  assignedToId    String?
  createdById     String
  activities      Activity[]
  aiInteractions  AiInteraction[]
  deals           Deal[]
  assignedTo      User?           @relation("AssignedRep", fields: [assignedToId], references: [id])
  createdBy       User            @relation("LeadCreator", fields: [createdById], references: [id])
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks           Task[]

  @@index([organizationId])
  @@index([assignedToId])
  @@index([status])
  @@index([email])
  @@map("leads")
}

model Deal {
  id                String          @id @default(cuid())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  title             String
  stage             DealStage       @default(DISCOVERY)
  value             Decimal?        @db.Decimal(12, 2)
  currency          String          @default("USD")
  probability       Int?
  closeDate         DateTime?
  closedAt          DateTime?
  description       String?
  lostReason        String?
  competitorNotes   String?
  aiStageSuggestion DealStage?
  aiRiskFlags       String[]
  lastActivityAt    DateTime?
  stageChangedAt    DateTime?
  leadId            String
  ownerId           String
  organizationId    String
  activities        Activity[]
  aiInteractions    AiInteraction[]
  lead              Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner             User            @relation("DealOwner", fields: [ownerId], references: [id])
  tasks             Task[]

  @@index([organizationId])
  @@index([leadId])
  @@index([ownerId])
  @@index([stage])
  @@map("deals")
}

model Activity {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  type           ActivityType
  title          String
  body           String?
  metadata       Json?
  isAutoLogged   Boolean      @default(false)
  leadId         String?
  dealId         String?
  userId         String?
  organizationId String
  deal           Deal?        @relation(fields: [dealId], references: [id])
  lead           Lead?        @relation(fields: [leadId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@index([dealId])
  @@index([organizationId])
  @@index([type])
  @@index([createdAt])
  @@map("activities")
}

model Task {
  id                    String           @id @default(cuid())
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  title                 String
  description           String?
  dueDate               DateTime?
  completedAt           DateTime?
  status                TaskStatus       @default(OPEN)
  priority              TaskPriority     @default(MEDIUM)
  isAutoCreated         Boolean          @default(false)
  leadId                String?
  dealId                String?
  assignedToId          String?
  createdById           String
  organizationId        String
  triggeredByWorkflowId String?
  assignedTo            User?            @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdBy             User             @relation("TaskCreator", fields: [createdById], references: [id])
  deal                  Deal?            @relation(fields: [dealId], references: [id])
  lead                  Lead?            @relation(fields: [leadId], references: [id])
  organization          Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  triggeredByWorkflow   WorkflowTrigger? @relation(fields: [triggeredByWorkflowId], references: [id])

  @@index([organizationId])
  @@index([assignedToId])
  @@index([leadId])
  @@index([dealId])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

model AiInteraction {
  id                String            @id @default(cuid())
  createdAt         DateTime          @default(now())
  type              AiInteractionType
  model             String
  promptTokens      Int
  completionTokens  Int
  totalTokens       Int
  latencyMs         Int
  isStreamed        Boolean           @default(false)
  systemPrompt      String?
  userPrompt        String
  response          String
  retrievedChunkIds String[]
  leadId            String?
  dealId            String?
  documentId        String?
  userId            String?
  organizationId    String
  queryVector       Float[]
  deal              Deal?             @relation(fields: [dealId], references: [id])
  document          Document?         @relation(fields: [documentId], references: [id])
  lead              Lead?             @relation(fields: [leadId], references: [id])
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User?             @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([leadId])
  @@index([type])
  @@index([createdAt])
  @@map("ai_interactions")
}

model WorkflowTrigger {
  id                String               @id @default(cuid())
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  name              String
  description       String?
  status            WorkflowStatus       @default(DRAFT)
  triggerEvent      WorkflowTriggerEvent
  triggerConditions Json?
  actionType        WorkflowActionType
  actionPayload     Json
  executionCount    Int                  @default(0)
  lastExecutedAt    DateTime?
  lastErrorAt       DateTime?
  lastError         String?
  organizationId    String
  createdTasks      Task[]
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([triggerEvent])
  @@index([status])
  @@map("workflow_triggers")
}

model ApiKey {
  id             String         @id @default(cuid())
  createdAt      DateTime       @default(now())
  label          String
  keyHash        String         @unique
  keyPrefix      String
  scope          ApiKeyScope    @default(FULL_ACCESS)
  isActive       Boolean        @default(true)
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  usageCount     Int            @default(0)
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  webhookEvents  WebhookEvent[]

  @@index([organizationId])
  @@index([keyHash])
  @@map("api_keys")
}

model Integration {
  id               String                  @id @default(cuid())
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  provider         IntegrationProvider
  label            String
  status           IntegrationStatus       @default(ACTIVE)
  config           Json?
  organizationId   String
  externalMappings ExternalObjectMapping[]
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  syncLogs         SyncLog[]
  webhookEvents    WebhookEvent[]

  @@index([organizationId])
  @@index([provider])
  @@index([status])
  @@map("integrations")
}

model ExternalObjectMapping {
  id                 String              @id @default(cuid())
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  provider           IntegrationProvider
  externalObjectType ExternalObjectType
  externalObjectId   String
  externalUrl        String?
  localLeadId        String?
  localDealId        String?
  metadata           Json?
  organizationId     String
  integrationId      String?
  integration        Integration?        @relation(fields: [integrationId], references: [id])
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, externalObjectType, externalObjectId])
  @@index([organizationId])
  @@index([integrationId])
  @@index([localLeadId])
  @@index([localDealId])
  @@map("external_object_mappings")
}

model WebhookEvent {
  id                 String              @id @default(cuid())
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  source             WebhookEventSource
  eventType          WebhookEventType
  status             WebhookEventStatus  @default(RECEIVED)
  externalObjectType ExternalObjectType?
  externalObjectId   String?
  payload            Json
  receivedAt         DateTime            @default(now())
  processedAt        DateTime?
  errorMessage       String?
  organizationId     String
  apiKeyId           String?
  integrationId      String?
  idempotencyKey     String?
  syncLogs           SyncLog[]
  apiKey             ApiKey?             @relation(fields: [apiKeyId], references: [id])
  integration        Integration?        @relation(fields: [integrationId], references: [id])
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowRuns       WorkflowRun[]

  @@unique([organizationId, source, eventType, idempotencyKey])
  @@index([organizationId])
  @@index([apiKeyId])
  @@index([integrationId])
  @@index([source])
  @@index([eventType])
  @@index([status])
  @@index([externalObjectType, externalObjectId])
  @@index([receivedAt])
  @@map("webhook_events")
}

model WorkflowRun {
  id             String            @id @default(cuid())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  type           WorkflowRunType
  status         WorkflowRunStatus @default(QUEUED)
  reviewStatus   WorkflowReviewStatus @default(NOT_REQUESTED)
  deliveryStatus WorkflowDeliveryStatus @default(NOT_REQUESTED)
  reviewedAt     DateTime?
  deliveredAt    DateTime?
  confidence     ConfidenceLevel?
  input          Json
  output         Json?
  startedAt      DateTime?
  completedAt    DateTime?
  errorMessage   String?
  attemptCount   Int               @default(0)
  maxAttempts    Int               @default(3)
  nextAttemptAt  DateTime?
  leaseOwner     String?
  leaseVersion   Int               @default(0)
  leaseExpiresAt DateTime?
  heartbeatAt    DateTime?
  organizationId String
  webhookEventId String?
  syncLogs       SyncLog[]
  usageTraces    UsageTrace[]
  activities     WorkflowRunActivity[]
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  webhookEvent   WebhookEvent?     @relation(fields: [webhookEventId], references: [id])

  @@index([organizationId])
  @@index([webhookEventId])
  @@index([type])
  @@index([status])
  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@index([createdAt])
  @@map("workflow_runs")
}

model QuestionnaireJob {
  id             String @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organizationId String
  format         String
  status         String @default("QUEUED")
  documentIds    String[]
  leaseOwner     String?
  leaseVersion   Int @default(0)
  leaseExpiresAt DateTime?
  rows           QuestionnaireRow[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([status, leaseExpiresAt])
  @@map("questionnaire_jobs")
}

model QuestionnaireRow {
  id           String @id @default(cuid())
  jobId        String
  rowIndex     Int
  rowId        String
  question     String
  status       String @default("QUEUED")
  attemptCount Int @default(0)
  answer       String?
  confidence   ConfidenceLevel?
  citations    Json @default("[]")
  errorCode    String?
  draftId      String? @unique
  updatedAt    DateTime @updatedAt
  job          QuestionnaireJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  draft        Draft? @relation(fields: [draftId], references: [id], onDelete: Restrict)

  @@unique([jobId, rowIndex])
  @@index([jobId, status])
  @@map("questionnaire_rows")
}

model WorkflowRunActivity {
  id             String @id @default(cuid())
  createdAt      DateTime @default(now())
  organizationId String
  workflowRunId  String
  kind           WorkflowRunActivityKind
  attemptCount   Int
  message        String?
  actorUserId    String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowRun    WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([workflowRunId, createdAt])
  @@map("workflow_run_activities")
}

model SyncLog {
  id                 String              @id @default(cuid())
  createdAt          DateTime            @default(now())
  direction          SyncDirection
  status             SyncStatus          @default(PENDING)
  provider           IntegrationProvider
  externalObjectType ExternalObjectType?
  externalObjectId   String?
  requestPayload     Json?
  responsePayload    Json?
  errorMessage       String?
  organizationId     String
  integrationId      String?
  webhookEventId     String?
  workflowRunId      String?
  integration        Integration?        @relation(fields: [integrationId], references: [id])
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  webhookEvent       WebhookEvent?       @relation(fields: [webhookEventId], references: [id])
  workflowRun        WorkflowRun?        @relation(fields: [workflowRunId], references: [id])

  @@index([organizationId])
  @@index([integrationId])
  @@index([webhookEventId])
  @@index([workflowRunId])
  @@index([provider])
  @@index([status])
  @@index([createdAt])
  @@map("sync_logs")
}

