generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model Organization {
  id               String                  @id @default(cuid())
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  name             String
  slug             String                  @unique
  logoUrl          String?
  website          String?
  industry         String?
  plan             PlanTier                @default(FREE)
  maxUsers         Int                     @default(5)
  maxDocuments     Int                     @default(20)
  maxLeads         Int                     @default(500)
  activities       Activity[]
  aiInteractions   AiInteraction[]
  apiKeys          ApiKey[]
  deals            Deal[]
  documents        Document[]
  externalMappings ExternalObjectMapping[]
  integrations     Integration[]
  invites          Invite[]
  leads            Lead[]
  syncLogs         SyncLog[]
  tasks            Task[]
  users            User[]
  webhookEvents    WebhookEvent[]
  workflowRuns     WorkflowRun[]
  workflows        WorkflowTrigger[]

  @@map("organizations")
}

model User {
  id                String          @id @default(cuid())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  email             String          @unique
  passwordHash      String
  firstName         String
  lastName          String
  avatarUrl         String?
  phone             String?
  title             String?
  timezone          String          @default("UTC")
  role              UserRole        @default(REP)
  isActive          Boolean         @default(true)
  lastLoginAt       DateTime?
  emailVerified     Boolean         @default(false)
  organizationId    String
  activities        Activity[]
  aiInteractions    AiInteraction[]
  assignedDeals     Deal[]          @relation("DealOwner")
  uploadedDocuments Document[]
  assignedLeads     Lead[]          @relation("AssignedRep")
  createdLeads      Lead[]          @relation("LeadCreator")
  refreshTokens     RefreshToken[]
  assignedTasks     Task[]          @relation("TaskAssignee")
  createdTasks      Task[]          @relation("TaskCreator")
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  token     String   @unique
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model Invite {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  expiresAt      DateTime
  email          String
  role           UserRole     @default(REP)
  token          String       @unique
  status         InviteStatus @default(PENDING)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([token])
  @@map("invites")
}

model Document {
  id             String          @id @default(cuid())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  filename       String
  displayName    String
  description    String?
  mimeType       String
  sizeBytes      Int
  fileType       DocumentType
  storagePath    String
  status         DocumentStatus  @default(PENDING)
  errorMessage   String?
  pageCount      Int?
  totalChunks    Int?
  embeddingModel String?
  ingestedAt     DateTime?
  jobId          String?
  tags           String[]
  organizationId String
  uploadedById   String
  aiInteractions AiInteraction[]
  chunks         DocumentChunk[]
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy     User            @relation(fields: [uploadedById], references: [id])

  @@index([organizationId])
  @@index([status])
  @@index([uploadedById])
  @@map("documents")
}

model DocumentChunk {
  id            String                 @id @default(cuid())
  createdAt     DateTime               @default(now())
  chunkIndex    Int
  text          String
  tokenCount    Int
  pageNumber    Int?
  documentId    String
  headingPath   String[]
  overlapTokens Int                    @default(0)
  sectionTitle  String?
  embedding     Unsupported("vector(768)")?
  document      Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@map("document_chunks")
}

model Lead {
  id              String          @id @default(cuid())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  firstName       String
  lastName        String
  email           String?
  phone           String?
  linkedinUrl     String?
  avatarUrl       String?
  company         String?
  jobTitle        String?
  department      String?
  companySize     String?
  industry        String?
  website         String?
  country         String?
  city            String?
  status          LeadStatus      @default(NEW)
  source          LeadSource      @default(MANUAL)
  tags            String[]
  notes           String?
  aiScore         Int?
  aiScoreReason   String?
  aiSummary       String?
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  emailOpenCount  Int             @default(0)
  emailClickCount Int             @default(0)
  customFields    Json?
  organizationId  String
  assignedToId    String?
  createdById     String
  activities      Activity[]
  aiInteractions  AiInteraction[]
  deals           Deal[]
  assignedTo      User?           @relation("AssignedRep", fields: [assignedToId], references: [id])
  createdBy       User            @relation("LeadCreator", fields: [createdById], references: [id])
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks           Task[]

  @@index([organizationId])
  @@index([assignedToId])
  @@index([status])
  @@index([email])
  @@map("leads")
}

model Deal {
  id                String          @id @default(cuid())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  title             String
  stage             DealStage       @default(DISCOVERY)
  value             Decimal?        @db.Decimal(12, 2)
  currency          String          @default("USD")
  probability       Int?
  closeDate         DateTime?
  closedAt          DateTime?
  description       String?
  lostReason        String?
  competitorNotes   String?
  aiStageSuggestion DealStage?
  aiRiskFlags       String[]
  lastActivityAt    DateTime?
  stageChangedAt    DateTime?
  leadId            String
  ownerId           String
  organizationId    String
  activities        Activity[]
  aiInteractions    AiInteraction[]
  lead              Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner             User            @relation("DealOwner", fields: [ownerId], references: [id])
  tasks             Task[]

  @@index([organizationId])
  @@index([leadId])
  @@index([ownerId])
  @@index([stage])
  @@map("deals")
}

model Activity {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  type           ActivityType
  title          String
  body           String?
  metadata       Json?
  isAutoLogged   Boolean      @default(false)
  leadId         String?
  dealId         String?
  userId         String?
  organizationId String
  deal           Deal?        @relation(fields: [dealId], references: [id])
  lead           Lead?        @relation(fields: [leadId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@index([dealId])
  @@index([organizationId])
  @@index([type])
  @@index([createdAt])
  @@map("activities")
}

model Task {
  id                    String           @id @default(cuid())
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  title                 String
  description           String?
  dueDate               DateTime?
  completedAt           DateTime?
  status                TaskStatus       @default(OPEN)
  priority              TaskPriority     @default(MEDIUM)
  isAutoCreated         Boolean          @default(false)
  leadId                String?
  dealId                String?
  assignedToId          String?
  createdById           String
  organizationId        String
  triggeredByWorkflowId String?
  assignedTo            User?            @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdBy             User             @relation("TaskCreator", fields: [createdById], references: [id])
  deal                  Deal?            @relation(fields: [dealId], references: [id])
  lead                  Lead?            @relation(fields: [leadId], references: [id])
  organization          Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  triggeredByWorkflow   WorkflowTrigger? @relation(fields: [triggeredByWorkflowId], references: [id])

  @@index([organizationId])
  @@index([assignedToId])
  @@index([leadId])
  @@index([dealId])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

model AiInteraction {
  id                String            @id @default(cuid())
  createdAt         DateTime          @default(now())
  type              AiInteractionType
  model             String
  promptTokens      Int
  completionTokens  Int
  totalTokens       Int
  latencyMs         Int
  isStreamed        Boolean           @default(false)
  systemPrompt      String?
  userPrompt        String
  response          String
  retrievedChunkIds String[]
  leadId            String?
  dealId            String?
  documentId        String?
  userId            String?
  organizationId    String
  queryVector       Float[]
  deal              Deal?             @relation(fields: [dealId], references: [id])
  document          Document?         @relation(fields: [documentId], references: [id])
  lead              Lead?             @relation(fields: [leadId], references: [id])
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User?             @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([leadId])
  @@index([type])
  @@index([createdAt])
  @@map("ai_interactions")
}

model WorkflowTrigger {
  id                String               @id @default(cuid())
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  name              String
  description       String?
  status            WorkflowStatus       @default(DRAFT)
  triggerEvent      WorkflowTriggerEvent
  triggerConditions Json?
  actionType        WorkflowActionType
  actionPayload     Json
  executionCount    Int                  @default(0)
  lastExecutedAt    DateTime?
  lastErrorAt       DateTime?
  lastError         String?
  organizationId    String
  createdTasks      Task[]
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([triggerEvent])
  @@index([status])
  @@map("workflow_triggers")
}

model ApiKey {
  id             String         @id @default(cuid())
  createdAt      DateTime       @default(now())
  label          String
  keyHash        String         @unique
  keyPrefix      String
  scope          ApiKeyScope    @default(FULL_ACCESS)
  isActive       Boolean        @default(true)
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  usageCount     Int            @default(0)
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  webhookEvents  WebhookEvent[]

  @@index([organizationId])
  @@index([keyHash])
  @@map("api_keys")
}

model Integration {
  id               String                  @id @default(cuid())
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  provider         IntegrationProvider
  label            String
  status           IntegrationStatus       @default(ACTIVE)
  config           Json?
  organizationId   String
  externalMappings ExternalObjectMapping[]
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  syncLogs         SyncLog[]
  webhookEvents    WebhookEvent[]

  @@index([organizationId])
  @@index([provider])
  @@index([status])
  @@map("integrations")
}

model ExternalObjectMapping {
  id                 String              @id @default(cuid())
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  provider           IntegrationProvider
  externalObjectType ExternalObjectType
  externalObjectId   String
  externalUrl        String?
  localLeadId        String?
  localDealId        String?
  metadata           Json?
  organizationId     String
  integrationId      String?
  integration        Integration?        @relation(fields: [integrationId], references: [id])
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, externalObjectType, externalObjectId])
  @@index([organizationId])
  @@index([integrationId])
  @@index([localLeadId])
  @@index([localDealId])
  @@map("external_object_mappings")
}

model WebhookEvent {
  id                 String              @id @default(cuid())
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  source             WebhookEventSource
  eventType          WebhookEventType
  status             WebhookEventStatus  @default(RECEIVED)
  externalObjectType ExternalObjectType?
  externalObjectId   String?
  payload            Json
  receivedAt         DateTime            @default(now())
  processedAt        DateTime?
  errorMessage       String?
  organizationId     String
  apiKeyId           String?
  integrationId      String?
  idempotencyKey     String?
  syncLogs           SyncLog[]
  apiKey             ApiKey?             @relation(fields: [apiKeyId], references: [id])
  integration        Integration?        @relation(fields: [integrationId], references: [id])
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowRuns       WorkflowRun[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([apiKeyId])
  @@index([integrationId])
  @@index([source])
  @@index([eventType])
  @@index([status])
  @@index([externalObjectType, externalObjectId])
  @@index([receivedAt])
  @@map("webhook_events")
}

model WorkflowRun {
  id             String            @id @default(cuid())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  type           WorkflowRunType
  status         WorkflowRunStatus @default(QUEUED)
  confidence     ConfidenceLevel?
  input          Json
  output         Json?
  startedAt      DateTime?
  completedAt    DateTime?
  errorMessage   String?
  organizationId String
  webhookEventId String?
  syncLogs       SyncLog[]
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  webhookEvent   WebhookEvent?     @relation(fields: [webhookEventId], references: [id])

  @@index([organizationId])
  @@index([webhookEventId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("workflow_runs")
}

model SyncLog {
  id                 String              @id @default(cuid())
  createdAt          DateTime            @default(now())
  direction          SyncDirection
  status             SyncStatus          @default(PENDING)
  provider           IntegrationProvider
  externalObjectType ExternalObjectType?
  externalObjectId   String?
  requestPayload     Json?
  responsePayload    Json?
  errorMessage       String?
  organizationId     String
  integrationId      String?
  webhookEventId     String?
  workflowRunId      String?
  integration        Integration?        @relation(fields: [integrationId], references: [id])
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  webhookEvent       WebhookEvent?       @relation(fields: [webhookEventId], references: [id])
  workflowRun        WorkflowRun?        @relation(fields: [workflowRunId], references: [id])

  @@index([organizationId])
  @@index([integrationId])
  @@index([webhookEventId])
  @@index([workflowRunId])
  @@index([provider])
  @@index([status])
  @@index([createdAt])
  @@map("sync_logs")
}

enum UserRole {
  ADMIN
  MANAGER
  REP
}

enum PlanTier {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum DocumentStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum DocumentType {
  PDF
  DOCX
  TXT
  MARKDOWN
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  NURTURING
  CONVERTED
  LOST
}

enum LeadSource {
  MANUAL
  IMPORT_CSV
  WEBHOOK
  LINKEDIN
  REFERRAL
  INBOUND_FORM
  COLD_OUTREACH
  OTHER
}

enum DealStage {
  DISCOVERY
  QUALIFICATION
  DEMO_SCHEDULED
  PROPOSAL_SENT
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum ActivityType {
  NOTE
  EMAIL_SENT
  EMAIL_RECEIVED
  CALL_OUTBOUND
  CALL_INBOUND
  MEETING
  TASK_COMPLETED
  STAGE_CHANGE
  LEAD_CREATED
  DEAL_CREATED
  AI_EMAIL_DRAFTED
  DOCUMENT_SHARED
  WEBHOOK_EVENT
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AiInteractionType {
  CHAT_MESSAGE
  EMAIL_DRAFT
  OBJECTION_HANDLER
  LEAD_SCORE_REASON
  MEETING_SUMMARY
}

enum WorkflowTriggerEvent {
  LEAD_CREATED
  LEAD_STATUS_CHANGED
  LEAD_REPLIED
  DEAL_STAGE_CHANGED
  DEAL_STALE
  TASK_OVERDUE
  DOCUMENT_INGESTED
  MEETING_LOGGED
}

enum WorkflowActionType {
  UPDATE_LEAD_STATUS
  UPDATE_DEAL_STAGE
  CREATE_TASK
  SEND_NOTIFICATION
  LOG_ACTIVITY
  ASSIGN_REP
}

enum WorkflowStatus {
  ACTIVE
  PAUSED
  DRAFT
}

enum ApiKeyScope {
  READ_ONLY
  FULL_ACCESS
  WEBHOOK_ONLY
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum IntegrationProvider {
  SALESFORCE
  HUBSPOT
  GMAIL
  OUTLOOK
  SLACK
  RECALL_AI
  N8N
  CUSTOM
}

enum IntegrationStatus {
  ACTIVE
  DISCONNECTED
  NEEDS_REAUTH
  PAUSED
}

enum ExternalObjectType {
  CONTACT
  COMPANY
  LEAD
  DEAL
  OPPORTUNITY
  TASK
  ACTIVITY
  EMAIL
  THREAD
  MEETING
  TRANSCRIPT
  USER
  OTHER
}

enum WebhookEventSource {
  N8N
  SALESFORCE
  HUBSPOT
  GMAIL
  OUTLOOK
  SLACK
  RECALL_AI
  MANUAL
  CUSTOM
}

enum WebhookEventType {
  EMAIL_RECEIVED
  EMAIL_SENT
  CALL_TRANSCRIPT_RECEIVED
  MEETING_LOGGED
  CRM_RECORD_CREATED
  CRM_RECORD_UPDATED
  CRM_STAGE_CHANGED
  MANUAL_QUESTION
  DOCUMENT_UPLOADED
  CUSTOM
}

enum WebhookEventStatus {
  RECEIVED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  IGNORED
}

enum WorkflowRunType {
  SALES_EVENT_EXTRACTION
  GROUNDED_TECHNICAL_ANSWER
  CRM_UPDATE_PREPARATION
  EMAIL_DRAFT
  CALL_SUMMARY
  CUSTOM
}

enum WorkflowRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  NEEDS_REVIEW
}

enum ConfidenceLevel {
  HIGH
  MEDIUM
  LOW
}

enum SyncDirection {
  INBOUND
  OUTBOUND
}

enum SyncStatus {
  PENDING
  SUCCESS
  FAILED
  SKIPPED
}
