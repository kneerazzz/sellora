      "parameters": {
        "jsCode": "const COMPANY_EMAIL = \"support@sellora.com\";\nconst email  = $json;\nconst missing = []\nconst from = email.from?.value?.[0]?.address;\nconst to = email.to?.value?.[0]?.address;\nif(!email.messageId && !email.threadId) missing.push(\"messageid or threadId\");\nif(!email.from) missing.push(\"from\");\nif(!email.text && !email.subject) missing.push(\"content or subject\");\nconst recipients = [\n  ...(email.to?.value ?? []),\n  ...(email.cc?.value ?? [])\n]\nconst sentToCompany = recipients.some(\n  recipient => recipient.address?.toLowerCase() === COMPANY_EMAIL.toLowerCase()\n);\nif (!sentToCompany) {\n  missing.push(\"email not addressed to company\");\n}\n\nconst payload = {\n  \"source\": \"N8N\",\n  \"messageId\": email.messageId,\n  \"threadId\": email.threadId,\n  \"from\": from,\n  \"to\": to,\n  \"subject\": email.subject,\n  \"text\": email.text,\n  \"receivedAt\": email.date || new Date().toISOString()\n}\n\nif(missing.length > 0){\n  return [{\n    json: {\n      valid: false,\n      error: `missing required email fields: ${missing.join(', ')}`,\n      payload\n    }\n  }]\n}\n\nreturn [{\n  json: {\n    valid: true,\n    idempotencyKey: email.messageId || email.threadId,\n    externalObjectId: email.messageId || email.threadId,\n    externalObjectType: \"EMAIL\",\n    payload\n  }\n}]"
      },
